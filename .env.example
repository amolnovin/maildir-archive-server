# ---- Maildir Archive Server ----
# Copy this file to .env and adjust if needed.
# (start.bat does this automatically on first run.)
# Keep this file ASCII-only: some tools read it with the system codepage.

TZ=Asia/Tehran
MAIL_HOSTNAME=mail.local

# If port 143 / 993 is already used on your machine, change these.
# Check with:  netstat -ano | findstr ":143"
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

PANEL_PORT=8080
WEBMAIL_PORT=8000
